{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.wled.slideeffect",
  "version": "2.3.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "YAWSEE",
    "sv": "YAWSEE"
  },
  "description": {
    "en": "Sliding on/off animations for WLED LED strips.",
    "sv": "Glidande på/av-animationer för WLED LED-slingor."
  },
  "tags": {
    "en": [
      "wled",
      "led",
      "esp32",
      "neopixel",
      "addressable"
    ],
    "sv": [
      "wled",
      "led",
      "esp32",
      "neopixel",
      "ledslinga",
      "adresserbar"
    ]
  },
  "category": "lights",
  "brandColor": "#E05000",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Peter Persson (Mr-V34)",
    "email": "info@v34.com"
  },
  "contributors": {
    "developers": [
      {
        "name": "B.Frank"
      }
    ]
  },
  "bugs": {
    "url": "https://github.com/Mr-V34/homey-wled-yawsee/issues"
  },
  "homepage": "https://github.com/Mr-V34/homey-wled-yawsee/blob/main/docs/MANUAL.md",
  "support": "mailto:info@v34.com",
  "source": "https://github.com/Mr-V34/homey-wled-yawsee",
  "flow": {
    "triggers": [
      {
        "id": "slide_completed",
        "title": {
          "en": "Sliding effect finished",
          "sv": "Glideffekten är klar"
        },
        "hint": {
          "en": "Fires when a slide animation completes on this device.",
          "sv": "Körs när en glidanimation är klar på den här enheten."
        },
        "tokens": [
          {
            "name": "direction",
            "type": "string",
            "title": {
              "en": "Slide direction",
              "sv": "Glidriktning"
            },
            "example": "on"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=wled_strip"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "slide_on",
        "title": {
          "en": "Slide ON",
          "sv": "Glid PÅ"
        },
        "hint": {
          "en": "LEDs fill one by one from start to end, then hold.",
          "sv": "Lysdioderna tänds en i taget från början till slut och lyser sedan kvar."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=wled_strip"
          }
        ]
      },
      {
        "id": "slide_off",
        "title": {
          "en": "Slide OFF",
          "sv": "Glid AV"
        },
        "hint": {
          "en": "LEDs clear one by one from end to start, then power off.",
          "sv": "Lysdioderna släcks en i taget från slut till början, sedan stängs slingan av."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=wled_strip"
          }
        ]
      },
      {
        "id": "set_reverse",
        "title": {
          "en": "Set slide direction",
          "sv": "Ställ in glidriktning"
        },
        "titleFormatted": {
          "en": "Set slide direction to [[direction]]",
          "sv": "Ställ in glidriktning till [[direction]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=wled_strip"
          },
          {
            "name": "direction",
            "type": "dropdown",
            "title": {
              "en": "Direction",
              "sv": "Riktning"
            },
            "values": [
              {
                "id": "forward",
                "label": {
                  "en": "Left to right",
                  "sv": "Vänster till höger"
                }
              },
              {
                "id": "reverse",
                "label": {
                  "en": "Right to left",
                  "sv": "Höger till vänster"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_slide_speed",
        "title": {
          "en": "Set slide speed",
          "sv": "Ställ in glidhastighet"
        },
        "titleFormatted": {
          "en": "Set slide speed to [[speed]] ms per LED",
          "sv": "Ställ in glidhastighet till [[speed]] ms per lysdiod"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=wled_strip"
          },
          {
            "name": "speed",
            "type": "number",
            "title": {
              "en": "Speed (ms per LED)",
              "sv": "Hastighet (ms per lysdiod)"
            },
            "min": 0,
            "max": 500,
            "step": 5
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "WLED Strip",
        "sv": "WLED-slinga"
      },
      "class": "light",
      "capabilities": [
        "onoff",
        "dim",
        "light_hue",
        "light_saturation",
        "light_temperature",
        "light_mode"
      ],
      "capabilitiesOptions": {
        "dim": {
          "title": {
            "en": "Brightness",
            "sv": "Ljusstyrka"
          }
        },
        "light_temperature": {
          "title": {
            "en": "Warm / Cool",
            "sv": "Varm / Kall"
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "discovery": "wled",
      "pair": [
        {
          "id": "list_devices",
          "title": {
            "en": "Select WLED Device",
            "sv": "Välj WLED-enhet"
          }
        },
        {
          "id": "manual_entry",
          "title": {
            "en": "Enter IP Address",
            "sv": "Ange IP-adress"
          }
        }
      ],
      "images": {
        "small": "/drivers/wled_strip/assets/images/small.png",
        "large": "/drivers/wled_strip/assets/images/large.png",
        "xlarge": "/drivers/wled_strip/assets/images/xlarge.png"
      },
      "id": "wled_strip",
      "settings": [
        {
          "id": "num_leds",
          "type": "number",
          "label": {
            "en": "Number of LEDs",
            "sv": "Antal lysdioder"
          },
          "value": 20,
          "min": 1,
          "max": 1024,
          "hint": {
            "en": "Must match your physical LED count.",
            "sv": "Måste stämma med antalet lysdioder på slingan."
          }
        },
        {
          "id": "slide_speed_ms",
          "type": "number",
          "label": {
            "en": "Slide speed (ms per LED)",
            "sv": "Glidhastighet (ms per lysdiod)"
          },
          "value": 25,
          "min": 0,
          "max": 500,
          "hint": {
            "en": "Time per LED step. 0 = as fast as possible. 25 ms × 40 LEDs = 1 second.",
            "sv": "Tid per lysdiodssteg. 0 = så snabbt som möjligt. 25 ms × 40 lysdioder = 1 sekund."
          }
        },
        {
          "id": "reverse",
          "type": "checkbox",
          "label": {
            "en": "Reverse direction",
            "sv": "Omvänd riktning"
          },
          "value": false,
          "hint": {
            "en": "When enabled, slide animations run right to left instead of left to right.",
            "sv": "När detta är på går glidanimationerna från höger till vänster i stället för vänster till höger."
          }
        },
        {
          "id": "firmware",
          "type": "label",
          "label": {
            "en": "WLED Firmware",
            "sv": "WLED-firmware"
          },
          "value": "Unknown"
        },
        {
          "id": "ip_address",
          "type": "label",
          "label": {
            "en": "IP Address",
            "sv": "IP-adress"
          },
          "value": "Unknown"
        }
      ]
    }
  ],
  "discovery": {
    "wled": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "_wled",
        "protocol": "tcp"
      },
      "id": "{{txt.mac}}"
    }
  }
}